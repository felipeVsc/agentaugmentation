# Copy to .env and fill in. .env is git-ignored and never written to any output (configs only name the variables).

# Neo4j: only needed to build task sets from the database (`tasks check-connection`, `tasks snapshot`, `tasks build`
# with dataset.source: neo4j). The code only reads from Neo4j.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
# NEO4J_DATABASE=neo4j

# Ollama Cloud (https://ollama.com/settings/keys): model calls of Strategy A and B, and the Ollama web search of
# Strategy B. Each config names the variable it reads (`api_key_env`); the final configs use these:
OLLAMA_API_KEY=


# Tavily web search (https://app.tavily.com): only for the early Strategy B configs with search.tool: tavily.
TAVILY_API_KEY=
