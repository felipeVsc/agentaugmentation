# Secrets: only the template is shared
.env
.env.*
!.env.example

# Python, tools, OS
venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.DS_Store

# External code (Comparing-Nodes, the context function of [1])
context_gen/

# Raw per-run logs: up to ~190 MB each, too large for git. Every figure and table is computed from results/*/scored/,
# results/energy_effort/ and the results.csv files, which stay in git. Share the raw logs separately if needed.
results/**/runs.jsonl
results/**/runs.csv

# Caches (LLM responses, web searches, chunk embeddings): ~1.4 GB of small files. They only avoid repeating paid API
# calls; results do not depend on them.
results/**/cache/
results/**/search_cache/
results/**/search_cache_ollama/
results/**/strategy_b_cache/
*.sqlite

# Graph export for sharing (43 MB); regenerate with scripts/export_football_lifted.py
exports/

